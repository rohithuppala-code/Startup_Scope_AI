### Supabase SQL Migrations (Run FIRST)

These must be executed in the Supabase SQL Editor before deploying code:

```sql
-- ============================================================
-- MIGRATION 1: Enable pgvector extension (idempotent)
-- ============================================================
CREATE EXTENSION IF NOT EXISTS vector;

-- ============================================================
-- MIGRATION 2: RAG Chunks table for grounding layer (Feature 2)
-- ============================================================
CREATE TABLE IF NOT EXISTS rag_chunks (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    validation_id UUID NOT NULL REFERENCES validations(id) ON DELETE CASCADE,
    source_url TEXT,
    chunk_index INTEGER NOT NULL,
    chunk_text TEXT NOT NULL,
    embedding vector(768),  -- Gemini text-embedding-004 native dimension
    created_at TIMESTAMPTZ DEFAULT now()
);

-- Cosine similarity index for fast nearest-neighbor search
CREATE INDEX IF NOT EXISTS idx_rag_chunks_embedding
    ON rag_chunks USING ivfflat (embedding vector_cosine_ops)
    WITH (lists = 100);

CREATE INDEX IF NOT EXISTS idx_rag_chunks_validation
    ON rag_chunks(validation_id);

-- ============================================================
-- MIGRATION 3: Report versions table for temporal tracking (Feature 4)
-- ============================================================
CREATE TABLE IF NOT EXISTS report_versions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    validation_id UUID NOT NULL REFERENCES validations(id) ON DELETE CASCADE,
    version_number INTEGER NOT NULL DEFAULT 1,
    report_json JSONB NOT NULL,
    markdown_report TEXT,
    diff_summary JSONB,           -- deepdiff output
    change_narrative TEXT,         -- Gemini-generated natural language summary
    tokens_used INTEGER DEFAULT 0,
    estimated_cost FLOAT DEFAULT 0.0,
    model_version TEXT,
    created_at TIMESTAMPTZ DEFAULT now(),
    UNIQUE(validation_id, version_number)
);

CREATE INDEX IF NOT EXISTS idx_report_versions_validation
    ON report_versions(validation_id);

-- ============================================================
-- MIGRATION 4: Pricing intelligence table (Feature 5)
-- ============================================================
CREATE TABLE IF NOT EXISTS pricing_intelligence (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    validation_id UUID NOT NULL REFERENCES validations(id) ON DELETE CASCADE,
    competitor_name TEXT NOT NULL,
    competitor_url TEXT,
    pricing_tiers JSONB NOT NULL,   -- [{tier_name, price, features: []}]
    gap_analysis TEXT,
    scraped_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_pricing_validation
    ON pricing_intelligence(validation_id);

-- ============================================================
-- MIGRATION 5: Funding intelligence table (Feature 6)
-- ============================================================
CREATE TABLE IF NOT EXISTS funding_intelligence (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    validation_id UUID NOT NULL REFERENCES validations(id) ON DELETE CASCADE,
    competitor_name TEXT NOT NULL,
    funding_rounds JSONB,          -- [{round, amount, date, investors: []}]
    total_funding TEXT,
    last_round_date TEXT,
    source_url TEXT,
    scraped_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_funding_validation
    ON funding_intelligence(validation_id);

-- ============================================================
-- MIGRATION 6: Social sentiment table (Feature 7)
-- ============================================================
CREATE TABLE IF NOT EXISTS social_sentiment (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    validation_id UUID NOT NULL REFERENCES validations(id) ON DELETE CASCADE,
    platform TEXT NOT NULL DEFAULT 'reddit',
    competitor_name TEXT,
    positive_count INTEGER DEFAULT 0,
    negative_count INTEGER DEFAULT 0,
    neutral_count INTEGER DEFAULT 0,
    market_buzz_score FLOAT DEFAULT 0.0,
    sample_posts JSONB,            -- [{title, url, sentiment, subreddit}]
    analyzed_at TIMESTAMPTZ DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_sentiment_validation
    ON social_sentiment(validation_id);

-- ============================================================
-- MIGRATION 7: Add consensus columns to validations table
-- ============================================================
ALTER TABLE validations
    ADD COLUMN IF NOT EXISTS gemini_report JSONB,
    ADD COLUMN IF NOT EXISTS groq_report JSONB,
    ADD COLUMN IF NOT EXISTS consensus_confidence FLOAT,
    ADD COLUMN IF NOT EXISTS model_agreement JSONB,
    ADD COLUMN IF NOT EXISTS pricing_data JSONB,
    ADD COLUMN IF NOT EXISTS funding_data JSONB,
    ADD COLUMN IF NOT EXISTS sentiment_data JSONB;
```

